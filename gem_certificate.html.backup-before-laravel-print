<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>AGL Gemstone Certificate</title>
<style>
  @page {
    size: 3.3in 2.1in;
    margin: 0;
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    padding: 0;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    font-family: "Georgia", "Times New Roman", serif;
  }
  .card {
    width: 3.3in;
    height: 2.1in;
    position: relative;
    overflow: hidden;
    background: #050505;
    color: #e4b23e;
    page-break-after: always;
    break-after: page;
  }
  .border1, .border2 {
    position: absolute;
    inset: 0.055in;
    border: 0.012in solid #f1cb68;
    border-radius: 0.09in;
    pointer-events: none;
  }
  .border2 {
    inset: 0.075in;
    border-color: #b98522;
    border-width: 0.007in;
    border-radius: 0.075in;
  }
  .content {
    position: absolute;
    inset: 0.105in;
  }
  .gold { color: #e4b23e; }
  .logo {
    position: absolute;
    left: 0.12in;
    top: 0.10in;
    width: 1.17in;
    height: auto;
  }
  .trust {
    position: absolute;
    left: 0.15in;
    top: 0.45in;
    width: 1.13in;
    text-align: center;
    font: 700 0.055in/1.2 Arial, sans-serif;
    letter-spacing: 0.035in;
    white-space: nowrap;
  }
  .title {
    position: absolute;
    left: 1.38in;
    top: 0.12in;
    width: 1.66in;
    text-align: center;
    font-size: 0.112in;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: 0.003in;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }
  .subtitle {
    position: absolute;
    left: 1.40in;
    top: 0.275in;
    width: 1.64in;
    text-align: center;
    font: 700 0.043in/1 Arial, sans-serif;
    letter-spacing: 0.014in;
    white-space: nowrap;
    overflow: hidden;
  }
  .rule {
    position: absolute;
    height: 0.008in;
    background: #e4b23e;
  }
  .rule-top {
    left: 1.48in; right: 0.16in; top: 0.35in;
  }
  .gem-frame {
    position: absolute;
    left: 0.14in;
    top: 0.59in;
    width: 1.08in;
    height: 0.79in;
    border: 0.012in solid #e4b23e;
    border-radius: 0.055in;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #020202;
  }
  .gem-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .report {
    position: absolute;
    left: 0.14in;
    top: 1.45in;
    width: 1.08in;
    height: 0.42in;
    border: 0.010in solid #e4b23e;
    border-radius: 0.055in;
    text-align: center;
    padding-top: 0.07in;
  }
  .report-label {
    font: 700 0.050in Arial, sans-serif;
    letter-spacing: 0.025in;
  }
  .report-value {
    margin-top: 0.035in;
    font: 700 0.047in Arial, sans-serif;
    letter-spacing: 0.008in;
    white-space: nowrap;
  }
  .fields {
    position: absolute;
    left: 1.43in;
    top: 0.52in;
    width: 1.56in;
  }
  .field {
    display: grid;
    grid-template-columns: 0.64in 0.06in 1fr;
    height: 0.115in;
    align-items: end;
  }
  .label {
    font: 700 0.050in Arial, sans-serif;
    letter-spacing: 0.012in;
    white-space: nowrap;
  }
  .colon {
    font: 700 0.050in Arial, sans-serif;
    text-align: center;
  }
  .value {
    border-bottom: 0.006in solid #b98522;
    min-width: 0;
    height: 0.085in;
    padding-left: 0.025in;
    font: 600 0.046in Arial, sans-serif;
    color: #f2d17a;
    white-space: nowrap;
    overflow: hidden;
  }
  .cert {
    position: absolute;
    left: 1.45in;
    bottom: 0.095in;
    width: 1.26in;
    text-align: center;
    font: 700 0.037in/1.3 Arial, sans-serif;
    letter-spacing: 0.012in;
  }
  .qr {
    position: absolute;
    right: 0.12in;
    bottom: 0.015in;
    width: 0.27in;
    height: 0.27in;
    border: 0.006in solid #e4b23e;
    display: grid;
    place-items: center;
    font: 700 0.032in Arial, sans-serif;
  }
  .qr::before {
    content: "VERIFY";
  }
  .waves {
    position: absolute;
    left: -0.05in;
    bottom: -0.08in;
    width: 1.15in;
    height: 0.42in;
    opacity: .7;
    background: repeating-radial-gradient(ellipse at -5% 100%, transparent 0 0.035in, #8e671d 0.039in 0.043in, transparent 0.047in 0.075in);
  }

  /* BACK */
  .back .logo {
    left: 50%;
    top: 0.44in;
    transform: translateX(-50%);
    width: 1.38in;
  }
  .back .divider {
    position: absolute;
    left: 0.95in;
    right: 0.95in;
    top: 1.12in;
    height: 0.008in;
    background: #e4b23e;
  }
  .back .contact {
    position: absolute;
    top: 1.27in;
    left: 0.25in;
    right: 0.25in;
    display: flex;
    justify-content: center;
    gap: 0.17in;
    align-items: center;
    font: 700 0.067in Arial, sans-serif;
    color: #f1cb68;
    white-space: nowrap;
  }
  .back .separator {
    height: 0.18in;
    width: 0.008in;
    background: #b98522;
  }
  .back .footer {
    position: absolute;
    top: 1.62in;
    left: 0.35in;
    right: 0.35in;
    text-align: center;
    font: 700 0.042in Arial, sans-serif;
    letter-spacing: 0.016in;
    color: #b98522;
  }
  .back .waves-left, .back .waves-right {
    position: absolute;
    bottom: -0.08in;
    width: 1.05in;
    height: 0.58in;
    opacity: .65;
    background: repeating-radial-gradient(ellipse at 0% 100%, transparent 0 0.035in, #8e671d 0.039in 0.043in, transparent 0.047in 0.075in);
  }
  .back .waves-left { left: -0.05in; }
  .back .waves-right { right: -0.05in; transform: scaleX(-1); }
</style>
</head>
<body>

<!-- FRONT: production placeholders use {field_name} -->
<section class="card front">
  <div class="border1"></div><div class="border2"></div>
  <div class="content">
    <img class="logo" src="data:image/svg+xml;base64," alt="AGL Logo">
    <div class="trust">TRUST&nbsp;&nbsp; | &nbsp;&nbsp;ACCURACY&nbsp;&nbsp; | &nbsp;&nbsp;VALUE</div>

    <div class="title">GEMSTONE CERTIFICATE</div>
    <div class="subtitle">NATURAL&nbsp;&nbsp; • &nbsp;&nbsp;AUTHENTIC&nbsp;&nbsp; • &nbsp;&nbsp;VERIFIED</div>
    <div class="rule rule-top"></div>

    <div class="gem-frame">
      <img id="gem-image" src="data:image/png;base64," alt="Gemstone">
    </div>

    <div class="report">
      <div class="report-label">REPORT NO.</div>
      <div class="report-value" id="report-no">{report_no}</div>
    </div>

    <div class="fields">
      <div class="field"><div class="label">GEMSTONE</div><div class="colon">:</div><div class="value">{gemstone}</div></div>
      <div class="field"><div class="label">SPECIES</div><div class="colon">:</div><div class="value">{species}</div></div>
      <div class="field"><div class="label">VARIETY</div><div class="colon">:</div><div class="value">{variety}</div></div>
      <div class="field"><div class="label">WEIGHT (CT)</div><div class="colon">:</div><div class="value">{weight_ct}</div></div>
      <div class="field"><div class="label">DIMENSIONS</div><div class="colon">:</div><div class="value">{dimensions_mm}</div></div>
      <div class="field"><div class="label">COLOR</div><div class="colon">:</div><div class="value">{color}</div></div>
      <div class="field"><div class="label">CLARITY</div><div class="colon">:</div><div class="value">{clarity}</div></div>
      <div class="field"><div class="label">SHAPE &amp; CUT</div><div class="colon">:</div><div class="value">{shape_cut}</div></div>
      <div class="field"><div class="label">TREATMENT</div><div class="colon">:</div><div class="value">{treatment}</div></div>
    </div>

    <div class="cert">CERTIFIED BY AGL<br>INDEPENDENT GEMOLOGICAL LABORATORY</div>
    <div class="qr" aria-label="Verification QR placeholder"></div>
    <div class="waves"></div>
  </div>
</section>

<!-- BACK -->
<section class="card back">
  <div class="border1"></div><div class="border2"></div>
  <div class="content">
    <img class="logo" src="data:image/svg+xml;base64," alt="AGL Logo">
    <div class="divider"></div>
    <div class="contact">
      <span>www.agldiamonds.com</span>
      <span class="separator"></span>
      <span>9815881899</span>
    </div>
    <div class="footer">AUTHENTIC GEM LAB&nbsp;&nbsp; • &nbsp;&nbsp;GEMSTONE IDENTIFICATION</div>
    <div class="waves-left"></div>
    <div class="waves-right"></div>
  </div>
</section>

<script>
/*
  AGL PRODUCTION DATA CONTRACT

  Required fields:
    report_no       = autogenerated in AGLYYMMDDHHMMSS format
    gemstone        = manual
    species         = manual
    variety         = manual
    weight_ct       = manual
    dimensions_mm   = manual
    color           = manual
    clarity         = manual
    shape_cut       = manual
    treatment       = manual
    gem_image       = image URL or base64 data URL

  In Laravel/PHP you can replace these values server-side, or call
  populateCertificate(yourRecord) before printing.
*/

function generateAGLReportNo(date = new Date()) {
  const yy = String(date.getFullYear()).slice(-2);
  const mm = String(date.getMonth() + 1).padStart(2, '0');
  const dd = String(date.getDate()).padStart(2, '0');
  const hh = String(date.getHours()).padStart(2, '0');
  const mi = String(date.getMinutes()).padStart(2, '0');
  const ss = String(date.getSeconds()).padStart(2, '0');
  return `AGL${yy}${mm}${dd}${hh}${mi}${ss}`;
}

function populateCertificate(data) {
  const fields = [
    'report_no', 'gemstone', 'species', 'variety', 'weight_ct',
    'dimensions_mm', 'color', 'clarity', 'shape_cut', 'treatment'
  ];

  fields.forEach(key => {
    const el = document.getElementById(key === 'report_no' ? 'report-no' : null);
    if (el && data[key] !== undefined) el.textContent = data[key];
  });

  const valueMap = {
    gemstone: 0,
    species: 1,
    variety: 2,
    weight_ct: 3,
    dimensions_mm: 4,
    color: 5,
    clarity: 6,
    shape_cut: 7,
    treatment: 8
  };

  const rows = document.querySelectorAll('.fields .field .value');
  Object.entries(valueMap).forEach(([key, index]) => {
    if (rows[index] && data[key] !== undefined) rows[index].textContent = data[key];
  });

  if (data.gem_image) {
    const img = document.getElementById('gem-image');
    img.src = data.gem_image;
  }
}

/* Example:
populateCertificate({
  report_no: generateAGLReportNo(),
  gemstone: 'Ruby',
  species: 'Corundum',
  variety: 'Natural Ruby',
  weight_ct: '2.18',
  dimensions_mm: '8.21 × 6.34 × 4.12',
  color: 'Vivid Red',
  clarity: 'Eye Clean',
  shape_cut: 'Oval Mixed Cut',
  treatment: 'No Indication of Heating',
  gem_image: '/uploads/gems/example-ruby.jpg'
});
*/
</script>
</body>
</html>