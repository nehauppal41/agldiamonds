        </div>

        <div class="agl-field">
            <div class="agl-field__label">Hardness</div>
            <div class="agl-field__colon">:</div>
            <div class="agl-field__value">{{ $certificate->hardness ?? '—' }}</div>
        </div>

    </div>

</div>
